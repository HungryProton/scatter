[sub_resource type="GDScript" id="GDScript_63p0w"]
script/source = "@tool
extends Marker3D

var _colors = [
	Color(1,0,0),
	Color(0,1,0),
	Color(0,0,1),
	Color(0,0,0),
	Color(1,1,0),
	Color(1,0,1),
	Color(0,1,1),
]

func _ready() -> void:
	for color in _colors:
		add_child(Marble.new(color, global_transform))

const TEST_LAYER_NO: int = 4
const TEST_LAYER_BITMASK: int = 1 << (TEST_LAYER_NO - 1)

class Marble extends RigidBody3D:

	var _start_transform: Transform3D
	var _color: Color

	func _init(color: Color, start_transform: Transform3D) -> void:
		_color = color
		_start_transform = start_transform
		collision_layer = TEST_LAYER_BITMASK
		collision_mask = TEST_LAYER_BITMASK 

	func _ready() -> void:
		_setup_visuals()

	func _integrate_forces(state: PhysicsDirectBodyState3D) -> void:
		# Check if we've fallen below the \"kill plane\"
		if state.transform.origin.y < 0.0:
			_respawn(state)

	func _respawn(state: PhysicsDirectBodyState3D) -> void:
		# 1. Reset the position and rotation to the start
		global_transform = _start_transform
		
		global_position.x += randf_range(-5,5)
		
		# 2. Kill all momentum so it doesn't \"keep flying\" after teleporting
		state.linear_velocity = Vector3.ZERO
		state.angular_velocity = Vector3.ZERO

	func _setup_visuals() -> void:
		# Create a simple MeshInstance and CollisionShape if they don't exist
		if get_child_count() == 0:
			# Visual Sphere
			var mesh_instance: MeshInstance3D = MeshInstance3D.new()
			mesh_instance.mesh = SphereMesh.new()
			mesh_instance.mesh.surface_set_material(0, _colormaterial(_color))
			add_child(mesh_instance)
			
			# Collision Shape
			var collision = CollisionShape3D.new()
			collision.shape = SphereShape3D.new()
			add_child(collision)

	func _colormaterial(color: Color) -> Material:
		var result: StandardMaterial3D = StandardMaterial3D.new()
		result.albedo_color = color
		return result

	
"

